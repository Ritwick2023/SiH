      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{handler=~\"/api/v1/assessment/.*\"}[5m])) by (le)) * 1000",
          "refId": "A"
        }
      ]
