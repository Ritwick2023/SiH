      "title": "Celery PDF Ingestion Throughput (docs/min)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(celery_tasks_completed_total[1m])) * 60",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
