rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.role == 'admin';
    }

    function isTrainerOrAdmin() {
      return isAuthenticated() && (request.auth.token.role == 'trainer' || request.auth.token.role == 'admin');
    }

    // Profiles: Users can only read their own profile, trainers and admins can view learner profiles
    match /profiles/{userId} {
      allow read: if isOwner(userId) || isTrainerOrAdmin();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Competencies & Catalogs: Public read for curriculum transparency
    match /competencies/{comp} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Assessments: Read by authenticated users, write by trainers/admins
    match /assessments/{assessmentId} {
      allow read: if isAuthenticated();
      allow write: if isTrainerOrAdmin();
    }

    // Assessment Submissions: Strictly owned by the submitter; trainers/admins can review
    match /assessment_submissions/{subId} {
      allow read: if (resource != null && isOwner(resource.data.userId)) || isTrainerOrAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Documents (MoSPI Manuals & Schedules)
    match /documents/{docId} {
      allow read: if isAuthenticated();
      allow create: if isTrainerOrAdmin();
      allow update, delete: if isAdmin() || (isTrainerOrAdmin() && resource.data.uploadedBy == request.auth.uid);
    }

    // Department Flags (Admin Write-Back Actions)
    match /department_flags/{flagId} {
      allow read: if isTrainerOrAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
