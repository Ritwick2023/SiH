# ==============================================================================
# StatVidya — Environment Configuration Template (.env.example)
# Sovereign Statistical Capacity Building Platform (MoSPI SIH 26101)
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Platform Mode & Application URL
# ------------------------------------------------------------------------------
# DEMO_MODE: Set to "false" in staging/production. When false, demo personas,
# demo OTP codes, and simulated tokens are completely disabled.
DEMO_MODE=true
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Cryptographic & Session Secrets (MANDATORY IN PRODUCTION)
# ------------------------------------------------------------------------------
# AUTH_SECRET: Minimum 32-character secret used to sign session cookies (HMAC-SHA256).
# Generate with: openssl rand -base64 32
AUTH_SECRET=statvidya_dev_secret_key_change_in_production_min_32_chars!

# ANALYTICS_API_SECRET: Secret token shared between Next.js and Python microservice.
# Generate with: openssl rand -hex 32
ANALYTICS_API_SECRET=statvidya_local_dev_secret_key_2026

# ------------------------------------------------------------------------------
# 3. Microservice Endpoints
# ------------------------------------------------------------------------------
NEXT_PUBLIC_ANALYTICS_SERVICE_URL=http://localhost:8000
DATABASE_URL=postgresql://statvidya_user:statvidya_dev_pg_insecure_local_only@localhost:5432/statvidya_db
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 4. Storage & Search
# ------------------------------------------------------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=statvidya_admin
MINIO_ROOT_PASSWORD=statvidya_dev_minio_insecure_local_only
ELASTICSEARCH_URL=http://localhost:9200

# ------------------------------------------------------------------------------
# 5. Parichay / Jan Parichay Government SSO (OIDC / OAuth2)
# ------------------------------------------------------------------------------
PARICHAY_ISSUER=https://parichay.nic.in
PARICHAY_CLIENT_ID=statvidya-client-id
PARICHAY_CLIENT_SECRET=statvidya-parichay-client-secret-change-in-prod
PARICHAY_AUTH_URL=https://parichay.nic.in/pnv1/api/oauth/authorize
PARICHAY_TOKEN_URL=https://parichay.nic.in/pnv1/api/oauth/token
PARICHAY_USERINFO_URL=https://parichay.nic.in/pnv1/api/oauth/userinfo

# ------------------------------------------------------------------------------
# 6. Firebase Web App Configuration (Auth, Firestore, Storage)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-app-id

# ------------------------------------------------------------------------------
# 7. AI Copilot (Gemini API)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key
